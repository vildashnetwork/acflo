# Server
PORT=5000

# MongoDB (copy your real values into .env)
MONGOURI=
MONGOURIOFFLINE=

# Cloudinary (Media library for images/files uploaded via the API)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_STUDENT_PHOTOS_FOLDER=acflo

# CORS — comma-separated list of allowed origins (empty = reflect any origin)
CORS_ORIGIN=

# Optional: when set, content/media mutations also accept header `x-api-token`
API_TOKEN=

# JWT signing secret for admin sessions (auto-generated random value)
JWT_SECRET=